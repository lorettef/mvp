# Auto-detect text files, normalize to LF
* text=auto

# Python
*.py text eol=lf
*.pyi text eol=lf

# TypeScript/JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf

# Configs
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.env.example text eol=lf
*.env text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf

# Shell
*.sh text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Binary (don't normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary

# Docker
Dockerfile text eol=lf
.dockerignore text eol=lf

# Git
.gitignore text eol=lf
.gitattributes text eol=lf
