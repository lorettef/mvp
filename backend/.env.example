# Общие настройки
APP_NAME=Startup Investment Bridge
DEBUG=false
SECRET_KEY=your-super-secret-key-min-32-characters-change-me
COOKIE_SECURE=false

# База данных
# Для продакшена (PostgreSQL): postgresql+asyncpg://user:strongpassword@db:5432/startup_engine
# Для локальной разработки (SQLite): sqlite+aiosqlite:///./startup_engine.db
DATABASE_URL=postgresql+asyncpg://postgres:changeme@db:5432/startup_engine

# AI-провайдер: deepseek | gigachat | demo
# deepseek — рекомендован (OpenAI-совместимый, дёшево, быстро)
# gigachat — Сбер (требует auth key + client id)
# demo — без нейросети (правила вместо AI)
AI_PROVIDER=deepseek

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
AI_QUOTA_ENABLED=false

# GigaChat (Сбер) — https://developers.sber.ru/
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_AUTH_KEY=your-auth-key
GIGACHAT_CLIENT_ID=your-client-id
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Демо-режим включайте только в защищённом pilot/dev environment. Endpoint
# дополнительно требует X-Demo-Seed-Token = DEMO_ACCOUNT_PASSWORD.
DEMO_MODE=false
# Deterministic demo login. Set only in a protected pilot/dev environment.
DEMO_ACCOUNT_EMAIL=demo@poicho.ru
DEMO_ACCOUNT_PASSWORD=
DEMO_ORGANIZATION_NAME=Demo Venture Fund
# Allowed values: 1, 5, 10. Re-running the seed safely resets this demo tenant.
DEMO_COMPANY_COUNT=5
# From backend/: python scripts/seed_demo.py

# CORS — домен(ы) через запятую
# Продакшен: https://mvp.poicho.ru
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
